diff --git a/src/kernel/kernel_hal.c b/src/kernel/kernel_hal.c
index 0306f92..97b6a49 100644
--- a/src/kernel/kernel_hal.c
+++ b/src/kernel/kernel_hal.c
@@ -365,6 +365,38 @@ void xbox_IrqlLeaveInterrupt(int saved)
         t_in_isr--;
 }
 
+/* Interrupts taken by a thread that busy-waits at raised IRQL.
+ *
+ * Device models hold their interrupts off while any thread is at or above
+ * DISPATCH_LEVEL (xbox_IrqlBlocksInterrupts): on the Xbox's one CPU such a
+ * thread is not running alongside the ISR. But a device IRQL is above
+ * DISPATCH_LEVEL, so on the console the ISR still preempts that thread -- and
+ * XDK code relies on it: DirectSound, called by XACT inside XACT's own raise,
+ * spins at DISPATCH_LEVEL for a voice to stop, and the flag it waits on is
+ * cleared by the APU's ISR. Held off here, every such wait ran into
+ * DirectSound's 0.5 s timeout (Amped 2: picture and sound froze for half a
+ * second in rides).
+ *
+ * A thread polling the clock is busy-waiting, which is a point where it has
+ * no half-edited state the ISR could see, so the clock bridges call this:
+ * when the thread is raised (and not inside an ISR itself), the hook a device
+ * model registered takes its pending interrupt on this thread, as the CPU
+ * would. DPCs the ISR queues stay queued -- the timer thread needs the
+ * dispatch lock this thread holds -- so they run once it lowers, as on the
+ * console. */
+void (*volatile xbox_irql_poll_hook)(void);
+
+void xbox_IrqlPollPoint(void)
+{
+    void (*hook)(void);
+
+    if (g_current_irql < DISPATCH_LEVEL || t_in_isr)
+        return;
+    hook = xbox_irql_poll_hook;
+    if (hook)
+        hook();
+}
