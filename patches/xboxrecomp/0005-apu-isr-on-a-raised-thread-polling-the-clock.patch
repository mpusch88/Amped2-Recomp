+/* The interrupt taken by a guest thread that busy-waits at raised IRQL
+ * (registered as xbox_irql_poll_hook; called from the clock bridges through
+ * xbox_IrqlPollPoint, see kernel_hal.c). On the console the APU's ISR
+ * preempts DISPATCH_LEVEL code; DirectSound, called by XACT inside XACT's own
+ * raise, spins there until the ISR has cleared a voice's stop-pending flag.
+ * The frame thread holds the interrupt off for as long as any thread is
+ * raised, so that wait always ran into DirectSound's 0.5 s timeout.
+ *
+ * The routine runs as a CPU would run it: on this thread, its guest stack
+ * (below the caller's esp, where an interrupt frame goes) and its TIB, at
+ * device IRQL. The thread already holds the dispatch lock, so entering IRQL
+ * 16 from its level takes nothing, and the DPC the routine queues waits for
+ * the thread to lower. The caller's guest registers are put back afterwards:
+ * the bridge is in the middle of a kernel call. d->lock is not held here; the
+ * routine's register accesses take it as any guest access does. */
+extern APU_TLS uint32_t g_ebp, g_seh_ebp;
+
+static void apu_isr_on_raised_thread(void)
+{
+    uint32_t kint, routine, context;
+    uint32_t s_eax, s_ecx, s_edx, s_ebx, s_esi, s_edi, s_esp, s_ebp, s_seh;
+    apu_guest_fn fn;
+
+    if (!InterlockedCompareExchange(&s_irq_line, 0, 0))
+        return;
+    if (InterlockedCompareExchange(&s_isr_busy, 1, 0) != 0)
+        return;
+    kint = xbox_GetConnectedInterrupt(APU_VECTOR);
+    routine = kint ? *(uint32_t *)(g_apu_ram_ptr + kint + 0) : 0;
+    context = kint ? *(uint32_t *)(g_apu_ram_ptr + kint + 4) : 0;
+    fn = routine ? recomp_lookup(routine) : NULL;
+    if (!fn) {
+        InterlockedExchange(&s_isr_busy, 0);
+        return;
+    }
+
+    s_eax = g_eax; s_ecx = g_ecx; s_edx = g_edx; s_ebx = g_ebx;
+    s_esi = g_esi; s_edi = g_edi; s_esp = g_esp; s_ebp = g_ebp;
+    s_seh = g_seh_ebp;
+    g_esp -= 4; *(uint32_t *)(g_apu_ram_ptr + g_esp) = context;
+    g_esp -= 4; *(uint32_t *)(g_apu_ram_ptr + g_esp) = kint;
+    g_esp -= 4; *(uint32_t *)(g_apu_ram_ptr + g_esp) = 0xDEADBEEFu;
+    { int _irql = xbox_IrqlEnterInterrupt(16); fn(); xbox_IrqlLeaveInterrupt(_irql); }
+    g_eax = s_eax; g_ecx = s_ecx; g_edx = s_edx; g_ebx = s_ebx;
+    g_esi = s_esi; g_edi = s_edi; g_esp = s_esp; g_ebp = s_ebp;
+    g_seh_ebp = s_seh;
+    InterlockedExchange(&s_isr_busy, 0);
+
+    {
+        static volatile LONG n;
+        LONG k = InterlockedIncrement(&n);
+        if (k <= 3 || (k & (k - 1)) == 0) {
+            fprintf(stderr, "[APU] interrupt taken on a raised thread polling the"
+                            " clock (%ld so far)\n", (long)k);
+            fflush(stderr);
+        }
+    }
+}
