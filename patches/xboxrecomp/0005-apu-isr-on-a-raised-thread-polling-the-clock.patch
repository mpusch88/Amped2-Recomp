                        mcpx_apu_frame_thread, d, QEMU_THREAD_JOINABLE);
+    xbox_irql_poll_hook = apu_isr_on_raised_thread;
     mcpx_apu_wait_for_idle(d);
     qemu_mutex_unlock(&d->lock);
 
@@ -1374,6 +1453,7 @@ void mcpx_apu_shutdown(MCPXAPUState *d)
     if (!d) return;
 
     fprintf(stderr, "[APU] Shutting down MCPX APU...\n");
+    xbox_irql_poll_hook = NULL;
 
     qemu_mutex_lock(&d->lock);
     mcpx_apu_wait_for_idle(d);
